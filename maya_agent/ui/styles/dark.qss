/* Maya Agent — dark professional theme */
/* Do NOT set QWidget background globally — it paints black bars on nested QLabels. */
QWidget {
    color: #e8e8ea;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget#centralRoot {
    background-color: #1e1f24;
}

QLabel {
    background: transparent;
    border: none;
}

QTextEdit, QPlainTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #2a2b32;
    border: 1px solid #3a3b44;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #3d6a9e;
    color: #e8e8ea;
}

QComboBox {
    padding-right: 26px;
    min-height: 24px;
}

QComboBox:editable QLineEdit {
    background: transparent;
    border: none;
    padding: 0 2px;
    color: #e8e8ea;
    selection-background-color: #3d6a9e;
}

/* Default browsers (help tab etc.) — bubble bodies override via #bubbleBody */
QTextBrowser {
    background-color: #2a2b32;
    border: 1px solid #3a3b44;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #3d6a9e;
    color: #e8e8ea;
}

QTextBrowser#bubbleBody {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 0;
    border-radius: 0;
}

QTextBrowser#chatView {
    background-color: #1a1b20;
    border: 1px solid #32333c;
    padding: 0;
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus, QComboBox:focus {
    border: 1px solid #5b8fc7;
}

QPlainTextEdit#composerInput {
    background-color: #22232a;
    border: 1px solid #3a3b44;
    border-radius: 8px;
    padding: 6px 10px;
}

QPushButton {
    background-color: #3d6a9e;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 26px;
}

QPushButton:hover {
    background-color: #4a7db5;
}

QPushButton:pressed {
    background-color: #325a86;
}

QPushButton:disabled {
    background-color: #3a3b44;
    color: #888;
}

QPushButton#secondaryBtn {
    background-color: #2f3038;
    border: 1px solid #4a4b55;
    color: #d0d0d6;
}

QPushButton#secondaryBtn:hover {
    background-color: #3a3b44;
    color: #ffffff;
}

QPushButton#compactLinkBtn {
    background-color: #2f3038;
    border: 1px solid #4a4b55;
    color: #d0d0d6;
    font-size: 12px;
    min-height: 24px;
    max-height: 24px;
    padding: 0 10px;
}

QPushButton#compactLinkBtn:hover {
    background-color: #3a3b44;
    color: #ffffff;
}

QPushButton#dangerBtn {
    background-color: #8b3a3a;
}

QPushButton#sendBtn {
    background-color: #2f7d5b;
    font-weight: 600;
    min-width: 56px;
    min-height: 26px;
    max-height: 26px;
    padding: 0 8px;
    border-radius: 6px;
}

QPushButton#sendBtn:hover {
    background-color: #38956c;
}

QPushButton#sendBtn:disabled {
    background-color: #2a4a3c;
    color: #7a9a8a;
}

QPushButton#stopBtn {
    background-color: #a03a3a;
    font-weight: 600;
    min-width: 56px;
    min-height: 26px;
    max-height: 26px;
    padding: 0 8px;
    border-radius: 6px;
    color: #ffffff;
}

QPushButton#stopBtn:hover {
    background-color: #b84848;
}

QPushButton#stopBtn:pressed {
    background-color: #8b3030;
}

QPushButton#composerBtn {
    background-color: #2a2b32;
    border: 1px solid #3a3b44;
    border-radius: 6px;
    color: #c8c8d0;
    font-size: 12px;
    min-width: 44px;
    min-height: 26px;
    max-height: 26px;
    padding: 0 6px;
}

QPushButton#composerBtn:hover {
    background-color: #34353e;
    border-color: #5b8fc7;
    color: #ffffff;
}

QPushButton#composerBtn:disabled {
    background-color: #25262c;
    border-color: #32333c;
    color: #5a5a62;
}

QPushButton#chipBtn {
    background-color: #262730;
    border: 1px solid #3a3b44;
    border-radius: 12px;
    padding: 4px 10px;
    min-height: 22px;
    color: #b8b8c0;
    font-size: 12px;
}

QPushButton#chipBtn:hover {
    background-color: #32333e;
    border-color: #5b8fc7;
    color: #e8e8ea;
}

QPushButton#attachBtn {
    background-color: #2a2b32;
    border: 1px solid #3a3b44;
    border-radius: 6px;
    color: #c8c8d0;
    font-size: 15px;
    font-weight: 600;
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton#attachBtn:hover {
    background-color: #32333e;
    border-color: #5b8fc7;
    color: #ffffff;
}

QPushButton#attachBtn:disabled {
    background-color: #25262c;
    border-color: #32333c;
    color: #5a5a62;
}

QPushButton#quickCmdBtn {
    background-color: #2a2b32;
    border: 1px solid #3a3b44;
    border-radius: 12px;
    color: #a8a8b0;
    font-size: 12px;
    padding: 0 8px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton#quickCmdBtn:hover {
    background-color: #34353e;
    border-color: #5b8fc7;
    color: #e8e8ea;
}

QPushButton#quickCmdBtn:checked {
    background-color: #2e3a48;
    border-color: #5b8fc7;
    color: #c8d8e8;
}

QWidget#composerStatus,
QWidget#statusBar {
    background: transparent;
    border: none;
}

QLabel#statusLabel {
    color: #7a7a84;
    font-size: 12px;
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#statusSpinner {
    background: transparent;
    border: none;
}

QWidget#quickHost {
    background: transparent;
    border: none;
}

QScrollArea#imageStrip {
    background: transparent;
    border: none;
}

QScrollArea#imageStrip QWidget#imageStripHost {
    background: transparent;
}

/* H-bar only when needed; strip height grows via _sync_attach_strip_height */
QScrollArea#imageStrip QScrollBar:horizontal {
    background: #1a1b20;
    height: 8px;
    margin: 0px 4px 1px 4px;
    border: none;
}

QScrollArea#imageStrip QScrollBar::handle:horizontal {
    background: #4a4b55;
    border-radius: 3px;
    min-width: 28px;
}

QScrollArea#imageStrip QScrollBar::handle:horizontal:hover {
    background: #5c5d68;
}

QScrollArea#imageStrip QScrollBar::add-line:horizontal,
QScrollArea#imageStrip QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}

QScrollArea#imageStrip QScrollBar::add-page:horizontal,
QScrollArea#imageStrip QScrollBar::sub-page:horizontal {
    background: transparent;
}

QFrame#toolbarFrame, QFrame#composerFrame {
    background-color: #24252c;
    border: 1px solid #33343d;
    border-radius: 10px;
}

QLabel#toolbarLabel {
    background: transparent;
    border: none;
    color: #a8a8b2;
    font-size: 12px;
    font-weight: 600;
    padding: 0 2px 0 0;
}

QComboBox#toolbarCombo {
    background-color: #2a2b32;
    border: 1px solid #40414c;
    border-radius: 6px;
    padding: 2px 8px;
    padding-right: 24px;
    color: #e8e8ea;
    font-size: 12px;
    min-height: 26px;
    max-height: 30px;
}

QComboBox#toolbarCombo:hover {
    border: 1px solid #555664;
    background-color: #30313a;
}

QComboBox#toolbarCombo:focus {
    border: 1px solid #5b8fc7;
}

QComboBox#toolbarCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox#toolbarCombo::down-arrow {
    width: 0;
    height: 0;
    border: none;
    image: none;
    background: transparent;
}

QComboBox#toolbarCombo QAbstractItemView {
    background-color: #2a2b32;
    border: 1px solid #40414c;
    selection-background-color: #3d6a9e;
    outline: none;
    padding: 4px;
}

QLineEdit#toolbarComboEdit {
    background: transparent;
    border: none;
    padding: 0 2px;
    margin-right: 2px;
    color: #e8e8ea;
    font-size: 12px;
    selection-background-color: #3d6a9e;
}

QSpinBox#toolbarSpin, QDoubleSpinBox#toolbarSpin {
    background-color: #2a2b32;
    border: 1px solid #40414c;
    border-radius: 6px;
    padding: 2px 6px;
    color: #e8e8ea;
    font-size: 12px;
    min-height: 26px;
}

QSpinBox#toolbarSpin:hover, QDoubleSpinBox#toolbarSpin:hover {
    border: 1px solid #555664;
    background-color: #30313a;
}

QSpinBox#toolbarSpin:focus, QDoubleSpinBox#toolbarSpin:focus {
    border: 1px solid #5b8fc7;
}

QSpinBox#toolbarSpin::up-button,
QSpinBox#toolbarSpin::down-button,
QDoubleSpinBox#toolbarSpin::up-button,
QDoubleSpinBox#toolbarSpin::down-button {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

QSpinBox#toolbarSpin::up-arrow,
QSpinBox#toolbarSpin::down-arrow,
QDoubleSpinBox#toolbarSpin::up-arrow,
QDoubleSpinBox#toolbarSpin::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border: none;
}

QLineEdit#toolbarSpinEdit {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: #e8e8ea;
    font-size: 12px;
    selection-background-color: #3d6a9e;
}

QPushButton#toolbarBtn {
    background-color: #2f3038;
    border: 1px solid #40414c;
    border-radius: 6px;
    color: #d0d0d6;
    font-size: 12px;
    font-weight: 500;
    padding: 0;
    min-height: 30px;
    max-height: 30px;
}

QPushButton#toolbarBtn:hover {
    background-color: #3a3b44;
    border-color: #5b8fc7;
    color: #ffffff;
}

QPushButton#toolbarBtn:pressed {
    background-color: #32333c;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4a4b55;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #4a4b55;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QLabel#titleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #f0f0f2;
}

QLabel#hintLabel {
    color: #9a9aa3;
    font-size: 11px;
}

QLabel#sceneHintLabel {
    color: #9a9aa3;
    font-size: 11px;
    padding-left: 4px;
}

QLabel#statusLabel {
    color: #8a8a93;
    font-size: 12px;
    padding-left: 0;
}

QLabel#statusSpinner {
    color: #8fd4a8;
    font-size: 13px;
    font-weight: 600;
}

QWidget#statusBar {
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #2a2b32;
    selection-background-color: #3d6a9e;
    border: 1px solid #3a3b44;
}

QTabWidget#mainTabs::pane {
    border: none;
    background: transparent;
    top: 0;
}

QTabWidget#settingsTabs::pane {
    border: 1px solid #33343d;
    border-radius: 8px;
    background: #1a1b20;
    top: 0;
    margin-top: 2px;
}

QTabWidget#settingsTabs QTabBar::tab {
    padding: 7px 14px;
    font-size: 12px;
}

QWidget#settingsPanel {
    background: transparent;
}

QWidget#settingsPage {
    background: transparent;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget {
    background: transparent;
}

QFrame#settingsSection {
    background-color: #22232a;
    border: 1px solid #33343d;
    border-radius: 10px;
}

QLabel#settingsSectionTitle {
    color: #f0f0f2;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#settingsSectionHint {
    color: #8a8a93;
    font-size: 11px;
    background: transparent;
}

QLabel#settingsFieldLabel {
    color: #b0b0b8;
    font-size: 12px;
    background: transparent;
    min-width: 88px;
}

QLabel#settingsOptionHint {
    color: #7e7e88;
    font-size: 11px;
    background: transparent;
}

QCheckBox#settingsCheck {
    color: #e8e8ea;
    font-size: 13px;
    spacing: 8px;
}

QFrame#settingsFooter {
    background: transparent;
    border-top: 1px solid #2e2f38;
    padding-top: 8px;
}

QTreeWidget#settingsToolTree {
    background-color: #22232a;
    border: 1px solid #33343d;
    border-radius: 10px;
    outline: none;
    padding: 6px 4px;
    show-decoration-selected: 1;
}

QTreeWidget#settingsToolTree::item {
    padding: 5px 8px;
    border-radius: 4px;
    min-height: 22px;
}

QTreeWidget#settingsToolTree::item:selected {
    background-color: #3d6a9e;
    color: #ffffff;
}

QTreeWidget#settingsToolTree::item:hover:!selected {
    background-color: #2f3038;
}

QTreeWidget#settingsToolTree::branch {
    background: transparent;
}

QTextEdit#settingsToolDesc {
    background-color: #22232a;
    border: 1px solid #33343d;
    border-radius: 10px;
    padding: 8px 10px;
    color: #c8c8d0;
}

QLabel#settingsHelpTitle {
    color: #f0f0f2;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

QLabel#settingsHelpVersion {
    color: #8a8a93;
    font-size: 12px;
    background: transparent;
    padding-top: 3px;
}

QLabel#settingsHelpBody {
    color: #c4c4cc;
    font-size: 13px;
    background: transparent;
    line-height: 1.45;
}

QLabel#settingsHelpItem {
    color: #d0d0d6;
    font-size: 13px;
    background: transparent;
    padding: 2px 0;
}

QLabel#settingsHelpCat {
    color: #9eb6d4;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding-top: 8px;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #8a8a93;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #c8c8d0;
}

QTabBar::tab:selected {
    background: transparent;
    color: #e8e8ea;
    border-bottom: 2px solid #5b8fc7;
}

QListWidget {
    background-color: #22232a;
    border: 1px solid #33343d;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #3d6a9e;
}

QListWidget::item:hover {
    background-color: #2f3038;
}

QSplitter::handle {
    background: #3a3b44;
}

QSplitter#chatSplitter::handle {
    background-color: #33343d;
    border: none;
    margin: 0;
    border-radius: 0;
    height: 1px;
}

QSplitter#chatSplitter::handle:hover {
    background-color: #5b8fc7;
}

QGroupBox {
    border: 1px solid #3a3b44;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #b0b0b8;
}

QCheckBox {
    spacing: 8px;
}

QProgressBar {
    border: 1px solid #3a3b44;
    border-radius: 4px;
    background: #2a2b32;
    text-align: center;
    max-height: 6px;
}

QProgressBar::chunk {
    background: #5b8fc7;
    border-radius: 3px;
}


/* ---- Chat panel (moved from inline stylesheets) ---- */
QWidget#chatPanel, QWidget#chatContainer {
    background-color: #17181d;
}
QFrame#chatScrollShell {
    background-color: #17181d;
    border: 1px solid #2e2f36;
    border-radius: 10px;
}
QScrollArea#chatScroll {
    background-color: #17181d;
    border: none;
}
QFrame#chatScrollRail {
    background-color: #3a3b42;
    border: none;
    border-left: 1px solid #2a2b30;
    border-radius: 0px;
}
QScrollBar#chatRailBar:vertical {
    background: transparent;
    width: 14px;
    margin: 2px 3px;
    border: none;
}
QScrollBar#chatRailBar::handle:vertical {
    background: #7a7b84;
    border-radius: 3px;
    min-height: 32px;
    border: none;
}
QScrollBar#chatRailBar::handle:vertical:hover {
    background: #9697a0;
}
QScrollBar#chatRailBar::handle:vertical:pressed {
    background: #6a8fb8;
}
QScrollBar#chatRailBar::add-line:vertical,
QScrollBar#chatRailBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}
QScrollBar#chatRailBar::add-page:vertical,
QScrollBar#chatRailBar::sub-page:vertical {
    background: transparent;
}
QPushButton#chatJumpBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #e8e9ef;
    font-size: 13px;
    font-weight: 700;
    padding: 0px;
    margin: 0px;
    text-align: center;
}
QPushButton#chatJumpBtn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 36);
}
QPushButton#chatJumpBtn:pressed {
    color: #ffffff;
    background-color: rgba(91, 143, 199, 90);
}
QPushButton#chatJumpBtn:disabled {
    color: #707179;
    background: transparent;
}
QFrame#chatTurnSeparatorLine {
    background: #33343c;
    border: none;
    max-height: 1px;
}
QFrame#bubble_user {
    background-color: #2c4f73;
    border: 1px solid #5a8fc4;
    border-radius: 14px;
}
QFrame#bubble_assistant {
    background-color: #2c2d36;
    border: 1px solid #4a4b56;
    border-radius: 14px;
}
QFrame#bubble_error {
    background-color: #3a2424;
    border: 1px solid #7a4040;
    border-radius: 14px;
}
QLabel#chatAvatar {
    border-radius: 16px;
    font-size: 11px;
    font-weight: 700;
}
QFrame#toolRow, QFrame#thinkingRow {
    background-color: #1f2026;
    border: 1px solid #33343c;
    border-radius: 8px;
}
QLabel#choiceHint {
    color: #8a8a93;
    font-size: 11px;
    background: transparent;
    border: none;
}
QPushButton#choiceBtn {
    background-color: #2a3340;
    border: 1px solid #4a6a8a;
    border-radius: 8px;
    color: #c8daf0;
    font-size: 12px;
    padding: 8px 12px;
    min-height: 28px;
    text-align: left;
}
QPushButton#choiceBtn:hover:enabled {
    background-color: #334556;
    border-color: #5b8fc7;
    color: #e8f0fa;
}
QPushButton#choiceBtn:pressed:enabled {
    background-color: #2c4054;
}
QPushButton#choiceBtn:disabled {
    background-color: #25262c;
    border-color: #3a3b44;
    color: #6a6a72;
}
QFrame#imageChip,
QFrame#fileChip {
    background: #1c1d24;
    border: 1px solid #3a3b44;
    border-radius: 10px;
}
QFrame#imageChip:hover,
QFrame#fileChip:hover {
    background: #22232c;
    border-color: #565766;
}
QLabel#fileChipBadge {
    background: #2a2b34;
    color: #b4b4bc;
    border: none;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#fileChipName {
    color: #ececf0;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
    border: none;
    padding: 0;
}
QLabel#fileChipMeta {
    color: #8a8a98;
    font-size: 10px;
    background: transparent;
    border: none;
    padding: 0;
}
QPushButton#imageChipRemove {
    background: rgba(48, 28, 28, 220);
    color: #f0c0c0;
    border: 1px solid #5a3838;
    border-radius: 9px;
    font-size: 11px;
    padding: 0;
    min-height: 18px;
    margin: 3px;
}
QPushButton#imageChipRemove:hover {
    background: #5a3030;
    color: #ffe0e0;
    border-color: #804848;
}
